# ───────────────────────────────────────────────────────────────
#  COCOMCI — variables d'environnement
#  Copiez ce fichier en « .env » et renseignez vos valeurs.
# ───────────────────────────────────────────────────────────────

# Base de données PostgreSQL.
# En production, utilisez l'URL fournie par votre hébergeur
# (Neon, Supabase, Railway…) et conservez « ?sslmode=require ».
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Mot de passe de l'espace d'administration (/administration/*).
# OBLIGATOIRE en production : sans lui, l'administration est désactivée.
# Choisissez une phrase longue et unique.
ADMIN_PASSWORD=

# Adresse publique du site, utilisée pour les aperçus de partage
# sur WhatsApp, Facebook et les moteurs de recherche.
SITE_URL=https://cocomci.ci

# Bandeau « Version préliminaire ».
# Il s'affiche PAR DÉFAUT tant que les données authentiques ne sont pas
# en place. À la mise en ligne définitive, passez cette valeur à « off ».
PREVIEW_MODE=on
